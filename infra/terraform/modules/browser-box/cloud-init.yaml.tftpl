#cloud-config
# Agent host for the Seneschal scraper agent (a Temporal activity worker).
#
# The browser it drives runs on the OPERATOR'S LOCAL MACHINE and is reached
# over an SSH reverse tunnel: the operator runs
#   ssh -N -R 9222:127.0.0.1:9222 ubuntu@<this-box>
# which maps this box's 127.0.0.1:9222 to their local Chrome's CDP port. This
# box therefore no longer runs Chrome/noVNC/Xvfb itself -- it just runs the
# agent and acts as the SSH jump host. Living inside the VPC lets the agent
# reach the private Temporal frontend directly.
package_update: true
package_upgrade: false

# Operator SSH key (used for the reverse tunnel + admin access).
ssh_authorized_keys:
  - ${ssh_public_key}

write_files:
  # ---- Scraper agent ----
  - path: /etc/systemd/system/scraper-agent.service
    content: |
      [Unit]
      Description=Seneschal scraper agent
      After=network-online.target
      Wants=network-online.target

      [Service]
      User=browser
      WorkingDirectory=/opt/browser/app/agent
      ExecStartPre=/opt/browser/write-env.sh
      # Optional (leading '-'): the file is created by the ExecStartPre above,
      # so it won't exist on the very first activation.
      EnvironmentFile=-/opt/browser/agent.env
      ExecStart=/usr/bin/node dist/worker.js
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  # ---- Runtime env writer (fetches the shared token from Secrets Manager) ----
  - path: /opt/browser/write-env.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      TOKEN="$(aws secretsmanager get-secret-value \
        --secret-id "${agent_token_secret_arn}" \
        --region "${region}" \
        --query SecretString --output text)"
      cat > /opt/browser/agent.env <<EOF
      API_BASE_URL=${api_base_url}
      AGENT_TOKEN=$TOKEN
      CHROME_CDP_URL=http://127.0.0.1:9222
      AGENT_NAME=${agent_name}
      TEMPORAL_ADDRESS=${temporal_address}
      TEMPORAL_NAMESPACE=${temporal_namespace}
      TEMPORAL_BROWSER_TASK_QUEUE=${browser_task_queue}
      EOF
      chown browser:browser /opt/browser/agent.env
      chmod 600 /opt/browser/agent.env

  # ---- Agent deploy: pull the CI-built artifact from S3 and restart ----
  # Invoked at boot and by the agent pipeline's Deploy stage (via SSM
  # RunCommand). CI builds the artifact; the box just pulls it.
  - path: /opt/browser/deploy-agent.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      TMP="$(mktemp -d)"
      echo "Fetching agent artifact from s3://${agent_releases_bucket}/agent/latest/agent.tar.gz"
      aws s3 cp "s3://${agent_releases_bucket}/agent/latest/agent.tar.gz" "$TMP/agent.tar.gz" --region "${region}"
      rm -rf /opt/browser/app/agent
      mkdir -p /opt/browser/app/agent
      tar -xzf "$TMP/agent.tar.gz" -C /opt/browser/app/agent
      chown -R browser:browser /opt/browser/app
      rm -rf "$TMP"
      systemctl restart scraper-agent
      echo "Agent deployed and restarted."

  # ---- Main setup script ----
  - path: /opt/browser/setup.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      export DEBIAN_FRONTEND=noninteractive

      # Base packages (no browser stack -- Chrome runs on the operator's machine)
      apt-get update
      apt-get install -y curl jq unzip ca-certificates gnupg

      # Node.js 20
      curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
      apt-get install -y nodejs

      # AWS CLI v2
      curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
      unzip -q /tmp/awscliv2.zip -d /tmp
      /tmp/aws/install || /tmp/aws/install --update

      # Dedicated unprivileged user that runs the agent
      id browser >/dev/null 2>&1 || useradd -m -s /bin/bash browser
      mkdir -p /opt/browser/app/agent
      chown -R browser:browser /opt/browser

      # Pull the CI-built scraper agent artifact from S3. Best-effort: on the
      # very first boot the artifact may not exist yet (the agent pipeline
      # hasn't run). scraper-agent simply retries until the first deploy.
      /opt/browser/deploy-agent.sh || \
        echo "Agent artifact not available yet; will start after the first agent pipeline deploy."

      systemctl daemon-reload
      systemctl enable --now scraper-agent.service

runcmd:
  - ["/bin/bash", "/opt/browser/setup.sh"]
