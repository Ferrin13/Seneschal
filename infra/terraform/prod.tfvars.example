# Copy to prod.tfvars and fill in for your environment. prod.tfvars is gitignored.

region      = "us-west-2"
env         = "prod"
aws_profile = "seneschal"

# DNS — must already exist as a public hosted zone in Route53.
hosted_zone_name = "example.com"
api_subdomain    = "api"
web_subdomain    = "app"

# Existing VPC / RDS info (Terraform deploys ECS into this VPC).
existing_vpc_id               = "vpc-0123456789abcdef0"
existing_private_subnet_ids   = ["subnet-aaaa", "subnet-bbbb"]
existing_public_subnet_ids    = ["subnet-cccc", "subnet-dddd"]
existing_db_security_group_id = "sg-0123456789abcdef0"

# Provide EXACTLY ONE of these three:
# database_url             = "postgres://user:pass@host:5432/seneschal"
# database_url_secret_arn  = "arn:aws:secretsmanager:us-west-2:123456789012:secret:seneschal/db-AbCdEf"
database_url_secret_name = "/seneschal/prod/main-postgres-db"

# Firebase
firebase_project_id        = "seneschal-c4b9a"
firebase_sa_ssm_param_name = "/seneschal/prod/firebase-service-account"

# Backend sizing
backend_cpu           = 256
backend_memory        = 512
backend_desired_count = 1

# --- Deal hunter (Temporal + worker + Facebook scraping) ----------------

# OpenRouter powers all LLM traffic (triage, comps, evaluation). Required.
openrouter_api_key = "sk-or-v1-..."

# Craigslist site slug the hunter searches. Empty disables Craigslist.
craigslist_site = "boise"

# Self-hosted Temporal cluster. Named "parthadae" (not "seneschal") so it can
# be reused as shared infra across products. Defaults are usually fine.
temporal_name_prefix            = "parthadae"
temporal_namespace_domain       = "parthadae.internal"
temporal_cpu                    = 512
temporal_memory                 = 1024
temporal_db_instance_class      = "db.t4g.micro"
temporal_db_deletion_protection = false

# Deal-hunter worker sizing.
worker_cpu           = 512
worker_memory        = 1024
worker_desired_count = 1

# --- Agent host (Facebook Marketplace scraping) -------------------------
# Facebook scraping is in scope for V1. The browser runs on the operator's
# LOCAL machine (logged into Facebook normally); this always-on EC2 box runs
# the scraper agent (a Temporal activity worker) and acts as the SSH jump host
# for the reverse CDP tunnel:
#   ssh -N -R 9222:127.0.0.1:9222 ubuntu@browser.<your-zone>
enable_browser_box    = true
browser_subdomain     = "browser"
browser_instance_type = "t3.small" # only runs the Node agent + SSH tunnel; t3.micro is plenty
browser_allowed_cidrs = ["203.0.113.4/32"] # LOCK to your IP(s) for SSH + the tunnel
agent_token           = "generate-a-long-random-string"
# SSH key for the operator (direct SSH + the reverse CDP tunnel to local Chrome).
browser_ssh_public_key = "ssh-ed25519 AAAA..."
# The scraper agent is built by the seneschal-agent CodePipeline (on pushes
# under agent/**) and pulled from S3 by the box, so there's no repo to clone.

# CI/CD
enable_pipeline = true
github_owner    = "your-github-username"
github_repo     = "Seneschal"
github_branch   = "main"

# Frontend build-time env vars. VITE_API_BASE_URL is filled in automatically.
frontend_build_env = {
  VITE_FIREBASE_API_KEY     = "AIzaSy..."
  VITE_FIREBASE_AUTH_DOMAIN = "seneschal-c4b9a.firebaseapp.com"
  VITE_FIREBASE_PROJECT_ID  = "seneschal-c4b9a"
  VITE_FIREBASE_APP_ID      = "1:1012077844190:web:..."
}
