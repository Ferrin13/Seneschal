# Backend runtime config
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres connection string (RDS in prod, local docker in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seneschal

# Firebase project ID (used to verify ID tokens). The service-account JSON is
# loaded from GOOGLE_APPLICATION_CREDENTIALS in dev, or from the metadata
# service / Parameter Store in production (see infra/).
FIREBASE_PROJECT_ID=seneschal-c4b9a
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# CORS — comma-separated list. Mobile clients don't need this; the web UI
# (frontend/) does. Default Vite dev origin shown below.
CORS_ORIGINS=http://localhost:5173

AWS_PROFILE=seneschal
AWS_REGION=us-west-2
S3_BUCKET=seneschal-images
# S3_ENDPOINT=http://localhost:4566

# --- Marketplace deal-finder -------------------------------------------
# Shared bearer token the browser-box scraper agent presents to /agent/*.
# Leave unset to disable the agent endpoints (503).
# AGENT_TOKEN=change-me-long-random

# LLM via OpenRouter (OpenAI-compatible). Leave OPENROUTER_API_KEY unset to
# disable LLM-backed features (search expansion, triage, evaluation) with a
# 503. Models are OpenRouter slugs and can be overridden per request to
# compare models. Every call's token usage + USD cost is logged to
# mp_llm_calls. See GET /marketplace/llm-usage for the cost breakdown.
# OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://app.seneschal.app
OPENROUTER_APP_NAME=Seneschal
# Newest OpenAI models: "terra" for cheap high-volume triage, "sol" for the
# capable deep evaluation, "luna" for comps web research (kept cheap because
# the web_search tool inflates prompt size). Swap freely (or override per
# request / per user in Settings).
LLM_TRIAGE_MODEL=openai/gpt-5.6-terra
LLM_ADVANCED_MODEL=openai/gpt-5.6-sol
LLM_COMPS_MODEL=openai/gpt-5.6-luna

# eBay Browse API for price comps (client-credentials).
# EBAY_CLIENT_ID=...
# EBAY_CLIENT_SECRET=...
EBAY_ENV=production

# Craigslist comps + search: local region slug (e.g. boise -> boise.craigslist.org).
# CRAIGSLIST_SITE=boise

# --- Temporal ----------------------------------------------------------
# Local dev cluster: docker compose -f infra/temporal/docker-compose.yml up -d
# Server RPC on 7233, Web UI on http://127.0.0.1:8233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=deal-hunter
TEMPORAL_BROWSER_TASK_QUEUE=browser-box
# How often each active target auto-hunts (minutes).
TEMPORAL_HUNT_INTERVAL_MIN=30
