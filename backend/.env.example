# Backend runtime config
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres connection string (RDS in prod, local docker in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seneschal

# Firebase project ID (used to verify ID tokens). The service-account JSON is
# loaded from GOOGLE_APPLICATION_CREDENTIALS in dev, or from the metadata
# service / Parameter Store in production (see infra/).
FIREBASE_PROJECT_ID=seneschal-c4b9a
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# CORS — comma-separated list. Mobile clients don't need this; the web UI
# (frontend/) does. Default Vite dev origin shown below.
CORS_ORIGINS=http://localhost:5173

AWS_PROFILE=seneschal
AWS_REGION=us-west-2
S3_BUCKET=seneschal-images
# S3_ENDPOINT=http://localhost:4566
